# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Vercel, the Neon integration sets this
# automatically (use the pooled connection string).
DATABASE_URL=postgres://user:password@host:5432/hisab?sslmode=require

# Random 32+ byte secret used to sign sessions. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app (no trailing slash). Optional on Vercel production
# (falls back to VERCEL_PROJECT_PRODUCTION_URL), required elsewhere.
BETTER_AUTH_URL=http://localhost:3000

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/reminders. Generate with: openssl rand -hex 24
CRON_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# Vercel Private Blob for receipts and avatars. Created by connecting a Blob
# store to the project. Without it, local development stores files under
# .data/uploads and production uploads are disabled.
BLOB_READ_WRITE_TOKEN=

# Transactional email (password reset) via Resend. Without it, reset links are
# logged to the server console in development and not sent in production.
RESEND_API_KEY=
EMAIL_FROM="Hisab <no-reply@your-domain.com>"

# Max pg pool connections per function instance (default 10).
DATABASE_POOL_MAX=10

# Set to 1 to enable auth rate limiting outside production.
AUTH_RATE_LIMIT=

# Integration tests use a separate database.
TEST_DATABASE_URL=postgres://localhost:5432/hisab_test
